# Runtime environment for the dockerified CliniAI v2.
#
# 1. Copy this file to docker/runtime.env  (git-ignored — NEVER commit it)
# 2. Fill in the secrets below
# 3. docker compose up --build   (from the docker/ folder)
#
# The image itself contains NO keys; everything here is injected at runtime.

# --- Secrets (required) ------------------------------------------------------
OPENAI_API_KEY=
# Cliniweb API key (provided separately by Cliniweb)
CLINIWEB_API_KEY=

# --- Optional overrides (sensible defaults are baked into app/config.py) -----
# LLM_PRIMARY_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODEL=gpt-4o
# SUPERVISOR_MODEL=gpt-4o-mini
# LOG_LEVEL=INFO

# SAFETY: never point this at the real booking site.
CLINIWEB_BOOKING_BASE=https://testers.cliniweb.com/info
